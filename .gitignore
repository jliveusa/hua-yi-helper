# 本地私有文件（含账号密码明文，严禁上传）
local/

# 开发文档（含技术细节，不公开）
docs/

# 本地脚本目录：默认全部不公开，仅以白名单逐个放行。
# ⚠️ 绝不要改成整目录放开 —— 这里曾存在硬编码明文密钥的一次性测试脚本，
#    白名单是防止此类文件被误提交的最后一道闸门。
scripts/*
scripts/lib/*
!scripts/auto-looper.mjs
!scripts/login-and-save-state.js
!scripts/notify-mail.js
!scripts/lib/
!scripts/lib/vision-ocr.cjs
!scripts/.env.local.example
test-screenshots/

# 日志与运行状态（含个人信息页面截图，严禁上传）
logs/

# 本地 agent 配置不公开，但 skills 需要随仓库发布
# （SKILL.md 内不含任何邮箱/密钥，收发地址一律由脚本从 .env.local 读取）
.claude/*
!.claude/skills/

# Node
node_modules/
package*.json

.workbuddy
