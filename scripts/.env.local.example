# 复制本文件为 scripts/.env.local 后填入自己的值。
# .env.local 已在 .gitignore 中，不会被提交；本 example 只含键名与格式说明。

# ═══════════════════════════════════════════════════════════
# 必填
# ═══════════════════════════════════════════════════════════

# 你所在地区的华医网主机名。华医网按地区划分子域，各地区数字不同，
# 因此脚本不内置默认值。查法：浏览器登录华医网，地址栏里的主机名就是它。
HUAYI_HOST=cmeXX.91huayi.com


# ═══════════════════════════════════════════════════════════
# 可选功能 ①：验证码自动识别
#   配置后可全自动登录（配合 --headless 真正无人值守）；
#   不配置则登录时弹出浏览器窗口，账号密码自动填好，由你手动输入验证码。
#   走 OpenAI Chat Completions 通用格式，任何兼容该格式、且模型支持图片
#   输入的服务都能用。三项缺一即视为未配置。
# ═══════════════════════════════════════════════════════════

# 到 /v1 为止，不要带 /chat/completions
VISION_BASE_URL=https://api.openai.com/v1
# 必须是具备图片（多模态）识别能力的模型
VISION_MODEL=gpt-4o-mini
VISION_API_KEY=
# bearer(默认，发 Authorization: Bearer) | api-key(发 api-key 请求头)
VISION_AUTH_STYLE=bearer
# 以下两项选填：部分服务要求显式 token 上限。
# 留空则完全不发送该字段（兼容性最好），需要时再打开。
# VISION_MAX_TOKENS=64
# VISION_TOKEN_PARAM=max_tokens        # 或 max_completion_tokens


# ═══════════════════════════════════════════════════════════
# 可选功能 ②：邮件通知（Resend）
#   配置后调度器完成/失败会发信，保活巡检 skill 也用它发通知；
#   不配置则仅写本地日志。三项缺一即视为未配置。
# ═══════════════════════════════════════════════════════════

RESEND_API_KEY=
# 发件人，格式：显示名 <地址>。发件域名需已在 Resend 验证。
RESEND_FROM=显示名 <you@your-domain.com>
# 收件人，多个用英文逗号分隔
RESEND_TO=you@example.com
